# Salin ke .env.local (lokal) atau set di platform deployment. Tidak ada secret di file ini.

# Origin canonical PRODUKSI (tanpa trailing slash). Dipakai untuk canonical, Open Graph,
# sitemap, dan JSON-LD — termasuk saat berjalan di staging, agar canonical tidak mengarah ke staging.
NEXT_PUBLIC_SITE_URL=https://www.smpinshafuddin.sch.id

# Hanya "production" yang mengizinkan pengindeksan. Kosong/nilai lain (staging, preview,
# subdomain review) → meta robots noindex + header X-Robots-Tag + robots.txt tanpa sitemap.
# Harus di-set saat BUILD karena halaman statis dan header dibentuk saat build.
SITE_ENV=staging

# Endpoint WordPress REST API (server-side). Default: https://www.smpinshafuddin.sch.id/wp-json/wp/v2
# NEXT_PUBLIC_WORDPRESS_API_URL=https://www.smpinshafuddin.sch.id/wp-json/wp/v2
